! name: AI & Crypto Fresh Focus
! description: Boosts very recent results for AI, ML, LLMs, tools, crypto AI (chatbots, agents, trading copilots). Demotes clickbait listicles, old hype, generic promo sites, and low-signal noise.
! public: true
! author: HardwareHater
! homepage: https://github.com/HardwareHater/Goggles-Collection

# Boost recent content
$boost=5,site=github.com
$boost=4,site=arxiv.org
$boost=3,site=reddit.com
$boost=3,site=dev.to
$boost=3,site=huggingface.co

# General anti-noise downranks
$downrank=3,host=medium.com
$downrank=3,host=*.substack.com
$downrank=2,host=forbes.com
$downrank=2,host=businessinsider.com
$downrank=2,host=investopedia.com
$downrank=3,host=*.blogspot.com
$downrank=3,host=quora.com
$downrank=2,host=*.linkedin.com/pulse

# Crypto/AI anti-hype
$downrank=4,host=cointelegraph.com
$downrank=4,host=bitcoinist.com
$downrank=3,host=news.bitcoin.com
$downrank=3,host=cryptonews.com

# Stronger optional discards (uncomment carefully)
# $discard,host=*.buzzfeed.com
